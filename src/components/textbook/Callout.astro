---
/**
 * The five margin icons of STYLE.md §3, drawn once. Use the named wrappers
 * (Tip, Remember, Warning, GoingDeeper, InXRayCalc) in chapters, never this
 * component directly, so that the set stays closed at five.
 *
 * The glyphs are this book's own. They deliberately avoid the shapes of the
 * Wiley "For Dummies" icons (lightbulb, bomb, target, the cartoon figure).
 * Going Deeper is a small multilayer stack, the book's subject.
 *
 * Going Deeper collapses on the web because it is skippable; the print
 * renderer opens every <details>. The other four are always open.
 */
export type CalloutKind = 'tip' | 'remember' | 'warning' | 'deeper' | 'xrc';

interface Props { kind: CalloutKind; title?: string; }
const { kind, title } = Astro.props;

const LABEL: Record<CalloutKind, string> = {
  tip: 'Tip',
  remember: 'Remember',
  warning: 'Warning',
  deeper: 'Going Deeper',
  xrc: 'In X-Ray Calc',
};
const heading = title ? `${LABEL[kind]}: ${title}` : LABEL[kind];
const collapsible = kind === 'deeper';
---
{collapsible ? (
  <details class={`box box-${kind} box-collapsible`}>
    <summary class="box-title">
      <svg class="box-icon" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3" y="4" width="18" height="3" rx="1" /><rect x="3" y="10.5" width="18" height="3" rx="1" /><rect x="3" y="17" width="18" height="3" rx="1" />
      </svg>
      <span>{heading}</span>
    </summary>
    <div class="box-body"><slot /></div>
  </details>
) : (
  <aside class={`box box-${kind}`} aria-label={LABEL[kind]}>
    <p class="box-title">
      {kind === 'tip' && (
        <svg class="box-icon" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="9" fill="none" stroke-width="2" /><path d="M8 12h7M12 8.5l3.5 3.5L12 15.5" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      )}
      {kind === 'remember' && (
        <svg class="box-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 3h10v18l-5-4-5 4z" />
        </svg>
      )}
      {kind === 'warning' && (
        <svg class="box-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 3 22 20H2z" /><path d="M12 9v5M12 16.5v.5" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" />
        </svg>
      )}
      {kind === 'xrc' && (
        <svg class="box-icon" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="2.5" y="4" width="19" height="16" rx="2" fill="none" stroke-width="2" /><path d="M2.5 8.5h19" fill="none" stroke-width="2" /><path d="M5 17c2-6 4-6 5-3s3 3 5-4 3 2 4 4" fill="none" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      )}
      <span>{heading}</span>
    </p>
    <div class="box-body"><slot /></div>
  </aside>
)}
