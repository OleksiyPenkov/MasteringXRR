---
import '../styles/textbook.css';
import { getCollection } from 'astro:content';
import { PARTS, partHeading } from '../lib/parts';
import { BOOK_TITLE } from '../lib/site.mjs';
const chapters = (await getCollection('chapters')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Cache-Control" content="no-cache, must-revalidate" />
    <title>{BOOK_TITLE}</title>
  </head>
  <body>
    <header class="home-hero">
      <h1>{BOOK_TITLE}</h1>
      <p class="home-tagline">
        How to fit an X-ray reflectivity curve in X-Ray Calc 3, from the raw measurement
        to a result you can report.
      </p>
      <div class="home-meta">
        <p class="home-author">Oleksiy Penkov</p>
      </div>
    </header>
    <main class="home-body">
      {PARTS.map((part) => {
        const list = chapters.filter((c) => c.data.part === part.key);
        return list.length > 0 && (
          <section class="home-part">
            <h2>{partHeading(part.key)}</h2>
            <ul class="home-chapters">
              {list.map((c) => (
                <li>
                  <a href={`${base}/${c.id}`}>
                    <span class="home-num">{c.data.number === '' ? '·' : c.data.number}</span>
                    <span class="home-title">{c.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        );
      })}
    </main>
    <footer class="home-footer">{BOOK_TITLE} · © 2026 Oleksiy Penkov · <a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a></footer>
  </body>
</html>
