{
  "name": "mastering-xrr-fitting",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:links": "node scripts/check-links.mjs",
    "check:markers": "node scripts/check-markers.mjs",
    "check": "astro build && node scripts/check-links.mjs",
    "test:py": "python -m pytest pdf-build -q -p no:cacheprovider",
    "pdf:render": "node pdf-build/render-sections.mjs",
    "pdf:assemble": "python pdf-build/assemble.py",
    "pdf:verify": "python pdf-build/verify_pdf.py",
    "deploy": "astro build && node scripts/check-links.mjs && node scripts/deploy.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/svelte": "^9.0.0",
    "astro": "^7.0.0",
    "katex": "^0.17.0",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "svelte": "^5.56.3",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
